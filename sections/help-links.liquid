<link rel="stylesheet" href="{{ 'help-links.css' | asset_url }}" media="print" onload="this.media='all'">

{% assign heading = product.metafields.custom.help_links_heading %}
{% assign content = product.metafields.custom.help_links_intro_content %}
{% assign items = product.metafields.custom.help_links_item_list.value %}

{% if heading != blank or content != blank or items != blank %}

<div class="section section--padded helpful-links">
  <div class="container">

    {% if heading != blank %}
      <h2 class="section__heading {{ section.settings.heading_align }}">
        {{ heading }}
      </h2>
    {% endif %}

    {% if content != blank %}
      <p class="enlarge-text {{ section.settings.heading_align }} mb-10">
        {{ content }}
      </p>
    {% endif %}

    {% if items != blank %}
      <div class="helpful-links_list">
        {% for item in items %}
          <div class="helpful-links_item">

            <div class="helpful-links_item_content left">
              <h3>{{ item.link_title }}</h3>
            </div>

            <div class="helpful-links_item_content right">

              {% if item.description != blank %}
                <p>{{ item.description }}</p>
              {% endif %}

              {% if item.hyperlink_url != blank %}
                <a href="{{ item.hyperlink_url }}" class="inline-flex card__collection--arrow">
                  {{ item.hyperlink_text | default: 'Learn more' }}
                  <span class="has-ltr-icon flex items-center mis-2">
                    {% render 'icon-arrow-right' %}
                  </span>
                </a>
              {% endif %}

            </div>

          </div>
        {% endfor %}
      </div>
    {% endif %}

  </div>
</div>

{% endif %}