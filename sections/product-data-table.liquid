{{ 'product-data-table.css' | asset_url | stylesheet_tag }}

{% assign heading = product.metafields.custom.product_data_table_heading %}
{% assign table = product.metafields.custom.product_data_table %}

{% if heading != blank or table != blank %}
  <div class="section section--padded product-data-table">
    <div class="container">

      {% if heading != blank %}
        <h2 class="h4 section__heading text-center">
          {{ heading }}
        </h2>
      {% endif %}

      {% if table != blank %}
        <div class="product-data-table__wrapper">
          {{ table.value | raw }}
        </div>
      {% endif %}

    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "Product Data Table",
  "tag": "section",
  "class": "section",
  "presets": [
    {
      "name": "Product Data Table"
    }
  ]
}
{% endschema %}