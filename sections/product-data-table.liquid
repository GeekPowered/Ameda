{% assign table = product.metafields.custom.product_data_table %}

{% if table != blank %}
  <div class="section section--padded product-data-table">
    <div class="container">
      <div class="product-data-table__wrapper">
        {{ table.value | raw }}
        </div>
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "Product Data Table",
  "tag": "section",
  "class": "section",
  "presets": [
    {
      "name": "Product Data Table"
    }
  ]
}
{% endschema %}