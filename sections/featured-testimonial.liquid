{%- liquid
  assign color_scheme = section.settings.color_scheme
  assign bg_color = false

  if color_scheme == '1'
    assign bg_color = settings.color_scheme_1_bg
  elsif color_scheme == '2'
    assign bg_color = settings.color_scheme_2_bg
  elsif color_scheme == '3'
    assign bg_color = settings.color_scheme_3_bg
  endif

  if bg_color == settings.bg_color or bg_color == 'rgba(0,0,0,0)'
    assign bg_color = false
  endif

  if image_ratio == nil
    if section.settings.image_ratio == 'shortest' or section.settings.image_ratio == 'tallest'
      assign image_ratio = 1
    else
      assign image_ratio = section.settings.image_ratio
    endif
  elsif image_ratio == 0 or image_ratio == 99
    assign image_ratio = 1
  endif

  if section.settings.reviewer_image
    if large_image
      capture sizes
        render 'sizes-attribute', grid: true, min: 1
      endcapture
    elsif section.settings.card_size == 'small'
      capture sizes
        render 'sizes-attribute', grid: true, min: 2, md: 3, lg: 4, xl: 5
      endcapture
    elsif section.settings.card_size == 'medium'
      capture sizes
        render 'sizes-attribute', grid: true, min: 1, sm: 2, lg: 3, xl: 4
      endcapture
    else
      capture sizes
        render 'sizes-attribute', grid: true, min: 1, sm: 2, lg: 3
      endcapture
    endif
  endif
-%}

<style>
    .featured-review-card {
        display: flex;
        background: #fff;
        border-radius: 100rem;
    }
    .featured-review-card .featured-reviewer-image {
        width: 30rem;
        flex-shrink: 0;
    }
    .featured-review-card .featured-reviewer-image img {
        border-radius: 50%;
        width: 100%;
        aspect-ratio: 1/1;
        object-fit: cover;
    }
    .featured-review-card .reviewer-content {
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 2rem 6rem 2rem 2rem;
    }
    @media (max-width: 900px) {
        .featured-review-card {
            flex-direction: column;
        }
        .featured-review-card .reviewer-content {
            padding: 2rem;
        }
    }
</style>

<div class="section relative section--full-width{% unless section.settings.section_height == "tight" %} section--padded-{{ section.settings.section_height }}{% endunless %}{% if section.settings.dividers != "none" %} {{ section.settings.dividers }}{% endif %}{% unless color_scheme == 'none' %} color-scheme color-scheme--{{ color_scheme }}{% endunless %}{% if section.settings.baby_patterns == true %} baby-pattern{% endif %}"{% if settings.animations_enabled != "disabled" and section.settings.prevent_animation == false %} data-cc-animate{% endif %}>
  {%- unless section.settings.full_width -%}
    <div class="container">
  {%- endunless -%}

  <div class="featured-review-card">
    <div class="featured-reviewer-image">
        {%- if section.settings.reviewer_image -%}
            {% render 'image',
            image: section.settings.reviewer_image,
            widths: '320, 460, 600, 700, 800, 900, 1200',
            src_width: 460,
            src_placeholder: true,
            sizes: sizes,
            class: class
          %}
        {%- endif -%}
    </div>
    <div class="reviewer-content">
        {%- if section.settings.testimonial != blank -%}
            <p class="h4">
            {{ section.settings.testimonial }}
            </p>
        {%- endif -%}
        {%- if section.settings.reviewer != blank -%}
            <p class="font-bold mb-0">{{ section.settings.reviewer }}</p>
        {%- endif -%}
        {%- if section.settings.reviewer_location != blank -%}
            <p class="mb-0">{{ section.settings.reviewer_location }}</p>
        {%- endif -%}
    </div>
  </div>

  {%- unless section.settings.full_width -%}
    </div>
  {%- endunless -%}
</div>

{% schema %}
{
  "name": "Featured Testimonial",
  "tag": "section",
  "class": "cc-custom-liquid",
  "settings": [
    {
      "type": "textarea",
      "id": "testimonial",
      "label": "Testimonial"
    },
    {
      "type": "text",
      "id": "reviewer",
      "label": "Reviewer"
    },
    {
      "type": "text",
      "id": "reviewer_location",
      "label": "Reviewer Location"
    },
    {
      "type": "image_picker",
      "id": "reviewer_image",
      "label": "Reviewer Image",
      "info": "Upload an image of the reviewer."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "label": "Section height",
      "id": "section_height",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "tight",
          "label": "Tight"
        },
        {
          "value": "xsmall",
          "label": "Extra small"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        }
      ],
      "default": "default"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Make section full width",
      "default": false
    },
    {
      "type": "select",
      "id": "dividers",
      "label": "Dividing lines",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "border-top",
          "label": "Above"
        },
        {
          "value": "border-bottom",
          "label": "Below"
        },
        {
          "value": "border-top border-bottom",
          "label": "Above and below"
        }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "none",
          "label": "Default"
        },
        {
          "value": "1",
          "label": "Scheme 1"
        },
        {
          "value": "2",
          "label": "Scheme 2"
        },
        {
          "value": "3",
          "label": "Scheme 3"
        }
      ],
      "default": "none"
    },
    {
      "type": "checkbox",
      "id": "baby_patterns",
      "label": "Baby Pattern",
      "default": false
    },
    {
      "type": "header",
      "content": "SEO"
    },
    {
      "type": "checkbox",
      "id": "prevent_animation",
      "label": "Load the section without animation",
      "info": "If this section is visible when the page loads, enabling this setting can reduce CLS and may improve site speed scores. [Read more](https://cleancanvas.co.uk/support/enterprise/performance-guide)",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Featured Testimonial"
    }
  ],
  "disabled_on": {
    "groups": [
      "aside"
    ]
  }
}
{% endschema %}
