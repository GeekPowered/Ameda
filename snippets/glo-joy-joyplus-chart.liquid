<style>
    .table-wrapper table {
        border-radius: 1rem;
        overflow: hidden;
        box-shadow: 0 5px 15px rgba(0, 0, 0, .1);
        width: 100%;
    }
    .table-wrapper table tbody tr img {
      width: 20rem;
      display: block;
      margin: 0 auto 1rem auto;
      border-radius: 1rem;
      aspect-ratio: 1 / 1;
      object-fit: cover;
    }
    .table-wrapper table td,
    .table-wrapper table th {
        border: none;
    }
    .table-wrapper table thead tr {
        background: rgb(var(--link-color));
        color: #fff;
    }
    .table-wrapper table thead th {
        font-weight: 900;
        text-transform: uppercase;
        text-align: center;
    }
    .table-wrapper table tbody tr:nth-child(odd) {
        background-color: #fff;
    }
    .table-wrapper .pink-check {
        font-size: 1.5em;
        color: rgb(var(--link-color));
        font-weight: 900;
    }
    @media (max-width: 768px) {
        .table-wrapper {
            overflow: auto;
        }
        .table-wrapper table {
            min-width: 60rem;
        }
    }
</style>


<div class="table-wrapper">
    <table>
    <thead>
        <tr style="text-align: right;">
        <th></th>
        <th>{% if show_spanish %}GLO Portátil{% else %}GLO Wearable{% endif %}</th>
        <th>{% if show_spanish %}Mya Joy Plus{% else %}Mya Joy Plus{% endif %}</th>
        <th>{% if show_spanish %}Mya Joy{% else %}Mya Joy{% endif %}</th>
        </tr>
    </thead>
    <tbody>
        <tr>
