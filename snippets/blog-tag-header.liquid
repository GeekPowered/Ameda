<h1>{% if current_tags.size > 0 %}{{ current_tags.first }}{% else %}Milk 101 Blog{% endif %}</h1>
{% if current_tags.size > 0 %}
  {% assign blog_tag = shop.metaobjects['blog_category_seo'].values 
    | where: 'tag_slug', current_tags.first 
    | first %}

  {% if blog_tag and blog_tag.fields.intro.value != blank %}
    {{ blog_tag.fields.intro.value }}
  {% endif %}
{% endif %}