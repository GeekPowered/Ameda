{% assign breadcrumb_link = "" %}
{% assign breadcrumb_title = "" %}
{% assign parent_breadcrumb_link = "" %}
{% assign parent_breadcrumb_title = "" %}

{% if collection %}
  {% assign breadcrumb_link = collection.url %}
  {% assign breadcrumb_title = collection.title %}
{% elsif page %}
  {% assign breadcrumb_link = page.url %}
  {% assign breadcrumb_title = page.title %}
{% endif %}

{% comment %}
  Check if the metafield `parent.page` is set for the current page
{% endcomment %}
{% if page.metafields.parent.page %}
  {% assign parent_page = page.metafields.parent.page %}
  {% if parent_page.url and parent_page.title %}
    {% assign parent_breadcrumb_link = parent_page.url %}
    {% assign parent_breadcrumb_title = parent_page.title %}
  {% endif %}
{% endif %}

<nav class="breadcrumbs flex justify-between w-full" aria-label="Breadcrumbs">
  <ol class="breadcrumbs-list flex has-ltr-icon {{ extraclass }}">
    <!-- Home Breadcrumb -->
    <li class="flex items-center">
      <a class="breadcrumbs-list__link" href="{{ shop.url }}">Home</a>
      <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true" focusable="false" role="presentation" class="icon">
        <path d="m9.693 4.5 7.5 7.5-7.5 7.5" stroke="currentColor" stroke-width="1.5" fill="none"></path>
      </svg>
    </li>

    <!-- Parent Page Breadcrumb (if exists) -->
    {% if parent_breadcrumb_link and parent_breadcrumb_title %}
      <li class="flex items-center">
        <a class="breadcrumbs-list__link" href="{{ parent_breadcrumb_link }}">{{ parent_breadcrumb_title }}</a>
        <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true" focusable="false" role="presentation" class="icon">
          <path d="m9.693 4.5 7.5 7.5-7.5 7.5" stroke="currentColor" stroke-width="1.5" fill="none"></path>
        </svg>
      </li>
    {% endif %}

    <!-- Current Page or Collection Breadcrumb -->
    <li class="flex items-center">
      <a class="breadcrumbs-list__link" href="{{ breadcrumb_link }}" aria-current="page">{{ breadcrumb_title }}</a>
    </li>
  </ol>
</nav>

<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
        {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "{{ shop.url }}"
        },
        {% if parent_breadcrumb_link and parent_breadcrumb_title %}
        {
            "@type": "ListItem",
            "position": 2,
            "name": "{{ parent_breadcrumb_title }}",
            "item": "{{ parent_breadcrumb_link }}"
        },
        {
            "@type": "ListItem",
            "position": 3,
            "name": "{{ breadcrumb_title }}",
            "item": "{{ breadcrumb_link }}"
        }
        {% else %}
        {
            "@type": "ListItem",
            "position": 2,
            "name": "{{ breadcrumb_title }}",
            "item": "{{ breadcrumb_link }}"
        }
        {% endif %}
    ]
}
</script>
