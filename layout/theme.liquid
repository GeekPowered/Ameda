<script>
document.addEventListener('DOMContentLoaded', function () {

    // ---------------------------
    // MOBILE ONLY: < 1200px
    // ---------------------------
    if (window.innerWidth >= 1200) return;

    const header = document.querySelector('.cc-header');
    let scrollAnimation = null;

    function getHeaderHeight() {
        return header ? header.offsetHeight : 0;
    }

    // Adaptive smooth scroll for mobile
    function adaptiveScroll(target, extraOffset = 50) {
        if (!target) return;
        if (scrollAnimation) cancelAnimationFrame(scrollAnimation);

        function step() {
            const targetRect = target.getBoundingClientRect();
            const targetY = window.pageYOffset + targetRect.top - getHeaderHeight() - extraOffset;
            const distance = targetY - window.pageYOffset;

            if (Math.abs(distance) < 1) {
                window.scrollTo(0, targetY);
                scrollAnimation = null;
                return;
            }

            window.scrollBy(0, distance * 0.3);
            scrollAnimation = requestAnimationFrame(step);
        }

        scrollAnimation = requestAnimationFrame(step);
    }

    // Open accordion if anchor is inside one
    function openAccordion(anchor) {
        const details = anchor.closest('details');
        if (details && !details.hasAttribute('open')) {
            details.setAttribute('open', '');
            return new Promise(resolve => setTimeout(resolve, 350));
        }
        return Promise.resolve();
    }

    // Wait for images in sections
    function waitForImages(sections) {
        const promises = [];
        sections.forEach(section => {
            if (!section) return;
            Array.from(section.querySelectorAll('img')).forEach(img => {
                if (!img.complete) {
                    promises.push(new Promise(res => img.addEventListener('load', res)));
                }
            });
        });
        return Promise.all(promises);
    }

    // Wait for dynamic sections to stabilize
    function waitForDynamicSections(sections) {
        return new Promise(resolve => {
            let lastMutation = Date.now();
            const observers = [];

            function cleanup() {
                observers.forEach(o => o.disconnect());
                resolve();
            }

            sections.forEach(section => {
                if (!section) return;
                const observer = new MutationObserver(() => lastMutation = Date.now());
                observer.observe(section, { childList: true, subtree: true, attributes: true, characterData: true });
                observers.push(observer);
            });

            function check() {
                const now = Date.now();
                const imagesLoaded = sections.every(sec => !sec || Array.from(sec.querySelectorAll('img')).every(img => img.complete));
                if (now - lastMutation > 200 && imagesLoaded) {
                    cleanup();
                } else {
                    requestAnimationFrame(check);
                }
            }

            check();
        });
    }

    // Handle anchor click
    function handleAnchor(anchor) {
        const targetId = anchor.getAttribute('href').slice(1);
        const target = document.getElementById(targetId);
        if (!target) return;

        const dynamicSections = [
            document.querySelector('section:nth-of-type(2)'),
            document.querySelector('section:nth-of-type(3)'),
            document.querySelector('section:nth-of-type(5)'),
            document.querySelector('section:nth-of-type(6)'),
            document.querySelector('section:nth-of-type(9)'),
            document.querySelector('section:nth-of-type(16)'),
            document.querySelector('section:nth-of-type(17)') // section above target
        ];

        openAccordion(anchor)
        .then(() => waitForDynamicSections(dynamicSections))
        .then(() => waitForImages(dynamicSections))
        .then(() => new Promise(res => setTimeout(res, 50))) // small buffer to settle layout
        .then(() => adaptiveScroll(target, 50));

        // Avoid duplicate history entries
        if (window.location.hash !== `#${targetId}`) {
            history.pushState(null, '', `#${targetId}`);
        }
    }

    // Click listener for anchors
    document.addEventListener('click', function (e) {
        const anchor = e.target.closest('a[href^="#"]:not([href="#"])');
        if (!anchor) return;
        if (!document.getElementById(anchor.getAttribute('href').slice(1))) return;

        e.preventDefault();
        handleAnchor(anchor);
    });

    // Handle hash on page load without browser jumping
    (function scrollOnLoad() {
        if (!window.location.hash) return;

        // Temporarily remove hash to prevent browser auto-scroll
        const hash = window.location.hash;
        history.replaceState(null, '', ' ');

        const anchor = document.querySelector(`a[href="${hash}"]`);
        if (anchor) handleAnchor(anchor);
    })();

    // Handle back/forward buttons
    window.addEventListener('popstate', function () {
        const hash = window.location.hash;
        if (!hash) return;

        const anchor = document.querySelector(`a[href="${hash}"]`);
        if (anchor) handleAnchor(anchor);
    });

});
</script>
