    "custom_liquid_t9aVJm": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<div style=\"background:#fff;padding:1.5rem 2rem;border-radius:1rem;border:2px dashed #ef8d96; text-align:center;\"><h2 class=\"mb-2\">Material Matters: Hard Plastic vs. Soft Silicone\n</h2>\n<p class=\"font-bold h6\">Ameda offers a variety of flange options, each designed with the perfect balance of comfort and durability.</p><p class=\"mb-0\">Ameda's hard plastic flanges provide durable, consistent suction and a secure vacuum seal. The soft silicone inserts fit inside Ameda’s 24mm flanges to provide a customized and comfortable fit.\n</p></div>",
        "section_height": "tight",
        "full_width": false,
        "dividers": "none",
