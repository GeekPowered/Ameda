        "link_iW4y8p": {
          "type": "link",
          "settings": {
            "title": "Lifestyle and Frequency",
            "icon": "<svg width=\" 100%\" height=\" 100%\" viewBox=\"0 0 18 20\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n<path d=\"M1 10V7C1 6.20435 1.31607 5.44129 1.87868 4.87868C2.44129 4.31607 3.20435 4 4 4H17M17 4L14 1M17 4L14 7M17 10V13C17 13.7956 16.6839 14.5587 16.1213 15.1213C15.5587 15.6839 14.7956 16 14 16H1M1 16L4 19M1 16L4 13\" stroke=\"rgb(var(--link-color))\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n</svg>",
            "content": "",
            "custom_liquid": "<ul style=\"list-style: disc;\npadding-left: 1.2em;\">\n<li><strong>Occasional pumping</strong>: If you only pump occasionally, a manual pump or single electric pump can be a simple and affordable choice.</li>\n<li><strong>Pump regularly</strong>: If you pump regularly, consider a double electric, wearable, or hospital-strength pump to save time and support supply.</li>\n<li><strong>Exclusively pumping</strong>: If you exclusively pump, choose a hospital-strength or high-performance double electric pump made for frequent use.</li>\n</ul>",
            "link_text": "",
            "url": "",
            "link_text_2": "",
            "url_2": "",
            "hash": ""
          }
        },
        "link_NxV66U": {
