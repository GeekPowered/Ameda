    "multi_column_pjfpaD": {
      "type": "multi-column",
      "blocks": {
        "column_t66VjX": {
          "type": "column",
          "settings": {
            "enable_media": true,
            "image": "shopify://shop_images/SBS_4.png",
            "media_scale": 100,
            "heading": "Pumping Bra",
            "text": "<p>A hands-free pumping bra holds flanges in place so you can pump without using your hands—ideal for multitasking, working, or longer pumping sessions.</p>",
            "button_label": "",
            "button_link": ""
          }
        },
        "column_8TmmAh": {
          "type": "column",
          "settings": {
            "enable_media": true,
            "image": "shopify://shop_images/41wWM9bPXLL._SX466.jpg",
            "media_scale": 100,
            "heading": "Breast Shields",
            "text": "<p>Also known as flanges, breast shields come in various sizes to match different nipple widths and breast sizes. Using the right size can improve comfort and milk flow. Ameda offers a free Flange Sizing Guide to help you get started.</p>",
            "button_label": "",
            "button_link": ""
          }
        },
        "column_xzxKbU": {
          "type": "column",
          "settings": {
            "enable_media": true,
            "image": "shopify://shop_images/01_e187629e-5b77-408d-b285-53b899410ac5.jpg",
            "media_scale": 100,
            "heading": "Pump Parts",
            "text": "<p>Parts like valves and membranes are designed to be replaced regularly for best performance. Ameda’s tubing stays dry thanks to our patented HygieniKit® closed system, so it typically doesn’t require routine replacement. Always use compatible parts and follow Ameda’s recommendations.</p>",
            "button_label": "",
            "button_link": ""
          }
