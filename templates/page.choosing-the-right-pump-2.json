    "media_with_text_xBw8Wi": {
      "type": "media-with-text",
      "blocks": {
        "heading_aJwVig": {
          "type": "heading",
          "settings": {
            "heading": "How To Pump Milk Efficiently",
            "heading_size": "h2",
            "heading_h1": false
          }
        },
        "text_nXDbxf": {
          "type": "text",
          "settings": {
            "text": "<ul><li>Pump consistently to support your milk supply—especially if you're not breastfeeding.</li><li>Use a double electric pump to express both breasts at once - this can save time and help increase output.</li><li>Adjust suction to your <strong>maximum comfort vacuum</strong>—the highest level that’s effective without causing discomfort.</li></ul><p>Refer to your pump’s instruction manual for cleaning and usage guidelines.  All Ameda breast pumps include a printed instruction manual, and digital versions are also available at<a href=\"https://www.ameda.com\"> <span style=\"text-decoration:underline\"><strong>www.ameda.com</strong></span></a> for easy access.</p>",
            "enlarge_text": false
          }
        }
      },
      "block_order": [
        "heading_aJwVig",
        "text_nXDbxf"
      ],
