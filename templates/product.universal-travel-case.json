        "text_zAC33L": {
          "type": "text",
          "settings": {
            "text": "<ul><li>Designed to fit Ameda GLO, Mya Joy, and Mya Joy PLUS, as well as other standard breast pumps, providing ample space for pump parts and accessories.</li><li>Thoughtfully organized interior with dedicated compartments for flanges, bottles, tubing, charger, and accessories. Multiple pouches keep everything neatly in place, making it easy to locate what you need quickly.</li><li>Lightweight and compact, making it easy to carry whether you’re commuting to work, traveling, or heading out for the day. Its practical design ensures your pumping essentials are always within reach.</li><li>Made from durable, easy-to-clean fabric that stands up to daily use, ensuring longevity and hassle-free maintenance.</li><li>Built-in insulated compartment helps keep expressed milk cool when used with ice packs (sold separately), making it ideal for busy schedules and travel.</li><li>Versatile enough to double as a storage bag for snacks, baby essentials, or other daily necessities when not being used for pumping.</li></ul>",
            "enlarge_text": false
          }
        }
