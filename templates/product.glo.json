    "faq_WT7f3T": {
      "type": "faq",
      "blocks": {
        "question_PTJrBd": {
          "type": "question",
          "settings": {
            "icon": "none",
            "heading": "Will the Ameda Universal Breast Pump Travel Case fit all Ameda pumps?",
            "text": "<p>Yes! The Ameda Universal Breast Pump Travel Case is designed to perfectly fit both the Ameda Mya Joy and Mya Joy PLUS pumps, along with their accessories. Its flexible compartments and ample space provide convenient storage for your pump, flanges, bottles, and charger—keeping everything organized and ready for use wherever you go.</p>"
          }
        },
        "question_UyiqeJ": {
          "type": "question",
          "settings": {
            "icon": "none",
            "heading": "Can I use the insulated compartment without ice packs?",
            "text": "<p>The insulated compartment helps maintain a cooler temperature, but for optimal milk storage, we recommend using ice packs (not included) to keep your milk at a safe temperature during longer outings.</p>"
          }
        },
        "question_HeCVrf": {
          "type": "question",
          "settings": {
            "icon": "none",
            "heading": "Is the fabric easy to clean?",
            "text": "<p>Yes! The Ameda Universal Breast Pump Travel Case is made from durable, easy-to-clean fabric. Simply wipe the exterior and interior with a damp cloth to keep your bag fresh and ready for daily use.</p>"
          }
        },
        "question_YVK7m7": {
          "type": "question",
          "settings": {
            "icon": "none",
            "heading": "Can I carry the case as a shoulder bag?",
            "text": "<p>Absolutely. The case comes with an adjustable shoulder strap, making it easy to carry hands-free whether you’re navigating the office, daycare drop-off, or airport security.</p>"
          }
        },
        "question_wKMAtC": {
          "type": "question",
          "settings": {
            "icon": "none",
            "heading": "What’s the advantage of having a universal fit case?",
            "text": "<p>A universal fit allows you to continue using the same case even if you switch breast pumps in the future. Whether you upgrade your pump or change brands, your Ameda Universal Breast Pump Travel Case will remain your go-to for organized, discreet transport—making it a worthwhile purchase for the long term.</p>"
          }
        }
      },
