        "question_UyiqeJ": {
          "type": "question",
          "settings": {
            "icon": "none",
            "heading": "Can I use the insulated compartment without ice packs?",
            "text": "<p>The insulated compartment helps maintain a cooler temperature, but for optimal milk storage, we recommend using ice packs (not included) to keep your milk at a safe temperature during longer outings.</p>"
          }
        },
        "question_HeCVrf": {
          "type": "question",
          "settings": {
            "icon": "none",
            "heading": "Is the fabric easy to clean?",
            "text": "<p>Yes! The Ameda Universal Breast Pump Travel Case is made from durable, easy-to-clean fabric. Simply wipe the exterior and interior with a damp cloth to keep your bag fresh and ready for daily use.</p>"
