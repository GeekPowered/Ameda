    "media_with_text_CKF9Tw": {
      "type": "media-with-text",
      "blocks": {
        "heading_DgTLNx": {
          "type": "heading",
          "settings": {
            "heading": "Manual Breast Pumps",
            "heading_size": "h3",
            "heading_h1": false
          }
        },
        "text_A7fFxQ": {
          "type": "text",
          "settings": {
            "text": "<p>Our <a href=\"https://www.ameda.com/products/ameda-portable-manual-breast-pump\"><span style=\"text-decoration:underline\">manual breast pumps</span></a> provide a portable and affordable option for moms who need occasional pumping. Lightweight and easy to use, these pumps give you complete control over suction and speed, making them a great choice for moms who want a simple, hands-on pumping experience. Manual pumps are perfect for those moments when you need a quick and quiet pumping solution, without relying on electricity or batteries. Their compact size also makes them ideal for travel or keeping in your bag for unexpected pumping needs. With Ameda's manual pumps, you can achieve efficient milk expression at your own pace, wherever and whenever you need to.</p>",
            "enlarge_text": false
          }
        }
      },
